# Configuration de la base de données
MONGODB_URI=mongodb://localhost:27017/scraphub
DB_PATH=https://<ton-bucket>.r2.dev/fts_index.sqlite
DB_CACHE_PATH=tmp/fts_index.remote.sqlite

# API Lookup2Bz (victim manifest, files and cookies)
LOOKUP2BZ_BASE_URL=https://api.lookup2bz.xyz
LOOKUP2BZ_API_KEY=

# Secrets Fly.io (à définir via `fly secrets set ...`, jamais en dur)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Configuration JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Configuration du serveur
PORT=8080
NODE_ENV=development

# Configuration CORS
FRONTEND_URL=https://intel-scraphub.vercel.app
ALLOWED_ORIGINS=https://intel-scraphub.vercel.app

# Politique d'auth en URL (recommandé: false)
ALLOW_QUERY_AUTH_TOKEN=false

# Taille max des payloads JSON/x-www-form-urlencoded
BODY_SIZE_LIMIT=2mb

# Requêtes protégées (séparées par virgules ou retours ligne)
PROTECTED_SEARCH_TERMS=eva klecka,quentin grosz,marlene dos santos,tatard,gounot,claire domas,dominique domas,pierre domas,nolann domas,yaniss conan,nolann conan,376178242488369182

# Configuration email vérification
MAIL_SERVICE=gmail
MAIL_USER=
MAIL_APP_PASSWORD=
MAIL_FROM_NAME=ScrapHub
MAIL_FROM_EMAIL=

# Configuration de sécurité
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

# Configuration MongoDB (optionnel)
MONGO_OPTIONS_MAX_POOL_SIZE=10
MONGO_OPTIONS_SERVER_SELECTION_TIMEOUT_MS=5000

# Configuration Discord OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://intel-scraphub.vercel.app/discord/callback

# Configuration Spotify OAuth2
# Obtenir les credentials sur: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:5000/api/spotify/callback

# Clé API BrixHub (ne pas mettre de clé en dur dans le code)
BRIXHUB_API_KEY=

# Checkout marchand hébergé (Paysafe/Paysafecard ou autre PSP officiel)
PAYMENT_CHECKOUT_URL=
PAYMENT_WEBHOOK_SECRET=

# Clés API développeur. Stocker les clés dans les secrets, jamais dans Git.
# Exemple: [{"name":"client-pro","key":"api_key_a_remplacer","plan":"pro","requestsPerDay":1000}]
API_KEYS=[]

# Auto-join serveur Discord (optionnel)
DISCORD_GUILD_ID=
DISCORD_BOT_TOKEN=
